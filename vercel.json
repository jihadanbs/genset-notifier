{
  "crons": [
    {
      "path": "/api/notify",
      "schedule": "0 2 * * 1,3,5,6"
    },
    {
      "path": "/api/notify-off",
      "schedule": "30 2 * * 1,3,5,6"
    },
    {
      "path": "/api/check-timer",
      "schedule": "*/2 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}